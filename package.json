{
  "name": "home-furniture-server",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch --env-file=.env src/index.ts",
    "migrate:new": "kysely migrate:make",
    "migrate:unsafe": "kysely migrate:rollback --all && kysely migrate:latest",
    "migrate": "kysely migrate:latest",
    "selfhost": "cloudflared tunnel --url http://localhost:4000",
    "reconcile": "tsx --env-file=.env scripts/reconcile.ts",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "dependencies": {
    "better-sqlite3": "=11.8.1",
    "cloudflared": "=0.7.0",
    "cors": "=2.8.5",
    "express": "=4.21.2",
    "helmet": "=8.0.0",
    "kysely": "=0.27.5",
    "morgan": "=1.10.0",
    "multer": "=1.4.5-lts.1",
    "playfab-sdk": "=2.167.250117"
  },
  "devDependencies": {
    "@types/better-sqlite3": "=7.6.12",
    "@types/cors": "=2.8.17",
    "@types/express": "=5.0.0",
    "@types/morgan": "=1.9.9",
    "@types/multer": "=1.4.12",
    "@types/node": "=22.13.0",
    "kysely-ctl": "=0.10.1",
    "tsx": "=4.19.2"
  },
  "peerDependencies": {
    "typescript": "=5.2.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  }
}
